{
  "cli": {
    "version": ">= 11.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "xxxxxxxx-upload.apps.googleusercontent.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "xxxxxxxx-play.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "track": "internal"
    }
  }
}